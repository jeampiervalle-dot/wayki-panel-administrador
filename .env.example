# Copia este archivo como .env para ajustar el panel.
# El repo ya incluye un .env con las URLs de producción; este archivo documenta
# todas las variables que lee src/config.ts.

# Backend Django: login, usuarios, líneas, unidades y solicitudes.
VITE_API_URL=http://31.220.72.2:8000/api

# Backend Spring: catálogo de subrutas, geometría, paraderos y turnos.
