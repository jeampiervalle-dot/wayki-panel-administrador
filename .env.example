# Plantilla de variables de entorno del panel.
# Copia este archivo como .env y rellena con tus propias URLs.
# No pongas tokens reales en este archivo de ejemplo.

# Backend Django: login, usuarios, líneas, unidades y solicitudes.
VITE_API_URL=http://localhost:8000/api

# Backend Spring: catálogo de subrutas, geometría, paraderos y turnos.
VITE_RUTAS_API_URL=http://localhost:8080/api

# Opcional: geocodificación inversa de paraderos. Déjalo vacío si no lo usas.
VITE_GEOCODING_TOKEN=

# Opcional: token de Mapbox para el mapa. Nunca subas un token real.
VITE_MAPBOX_TOKEN=
