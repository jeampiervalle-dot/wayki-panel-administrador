# ============================================================
# Conexión del panel — base de datos gowayki_db
# Backend admin: https://github.com/VizcardoFabrizzio/gowayki-nest-admin-back
# (Django/DRF + JWT, misma base de datos que el backend principal)
# Copia este archivo como .env y ajusta la URL real.
# ============================================================

# gowayki-nest-admin-back (Django, puerto 8000 por defecto)
VITE_API_URL=http://localhost:8000/api

# Alternativa: backend principal Spring Boot
# VITE_API_URL=http://localhost:8080/api

# Mapa: por defecto usa OpenStreetMap (sin token). Si usas Mapbox, pon tu token:
# VITE_MAPBOX_TOKEN=tu_token
